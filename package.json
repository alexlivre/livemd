{
  "name": "livemd",
  "productName": "LiveMD",
  "version": "1.0.0",
  "description": "Leitor de Markdown com abas e auto-reload ao alterar o arquivo",
  "main": "out/main/index.js",
  "author": "Alex Santos <alexbreno2005@gmail.com> (https://alexlivre.dev/)",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:icon": "node scripts/build-icon.mjs",
    "pack": "npm run build && npm run build:icon && electron-builder --dir",
    "dist": "npm run build && npm run build:icon && electron-builder",
    "dist:win": "npm run build && npm run build:icon && electron-builder --win",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "dompurify": "^3.1.6",
    "highlight.js": "^11.10.0",
    "marked": "^14.1.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.7.5",
    "electron": "^32.1.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.7"
  },
  "build": {
    "appId": "com.livemd.app",
    "productName": "LiveMD",
    "copyright": "Copyright © 2026 Alex Santos",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LiveMD",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installer-header.bmp",
      "deleteAppDataOnUninstall": false,
      "warningsAsErrors": false,
      "include": "build/installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mdx"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor"
      }
    ]
  }
}
